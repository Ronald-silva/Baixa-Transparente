# Neon Database Connection String
# Obtenha em: https://console.neon.tech/
VITE_NEON_CONNECTION_STRING="postgresql://username:password@host/database?sslmode=require"

# Configurações de Segurança (Opcional)
VITE_ENABLE_RATE_LIMITING=true
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_RATE_LIMIT_WINDOW_MS=300000

# Configurações de Validação (Opcional)
VITE_MAX_DESCRIPTION_LENGTH=500
VITE_MAX_CURRENCY_VALUE=999999999.99

# Configurações de Interface (Opcional)
VITE_APP_NAME="Lumina Ledger"
VITE_APP_DESCRIPTION="Plataforma de Transparência Financeira"
